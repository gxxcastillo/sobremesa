# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
# -------------------------
# Default provider for all agents (anthropic, local, or mock)
# AI_PROVIDER_DEFAULT=anthropic

# Per-agent provider overrides (optional)
# AI_PROVIDER_INTERN=local
# AI_PROVIDER_SCRIBE=anthropic
# AI_PROVIDER_HISTORIAN=anthropic
# AI_PROVIDER_FACILITATOR=local
# AI_PROVIDER_CURATOR=local

# Anthropic (for cloud AI)
ANTHROPIC_API_KEY=sk-ant-...

# Local LLM (OpenAI-compatible API - Ollama, LM Studio, etc.)
# LOCAL_LLM_BASE_URL=http://um890.local:11434/v1
# LOCAL_LLM_MODEL=llama3.2:latest
# LOCAL_LLM_API_KEY=  # Optional, most local LLMs don't require it

# Telegram Bot Token
# Create via @BotFather on Telegram
# Important: Disable Privacy Mode (Bot Settings → Group Privacy → Turn off)
TELEGRAM_BOT_TOKEN=123:ABC123DEF

# Access Pass Secret (for JWT signing)
# Generate with: openssl rand -base64 32
ACCESS_PASS_SECRET=your-access-pass-secret-key-here

# Studio Web App URL (for access pass links)
# For local development: https://sobremesa.x:3000
# For production: https://studio.sobremesa.app
STUDIO_URL=https://sobremesa.x:3000

# Admin Login Secret (for credential-based login)
# Required in production for POST /api/auth/login
# Generate with: openssl rand -base64 32
ADMIN_LOGIN_SECRET=your-admin-login-secret-here
