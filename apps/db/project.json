{
  "name": "db",
  "sourceRoot": "{projectRoot}/src",
  "targets": {
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "{projectRoot}/scripts/ensure-docker.sh supabase start"
      }
    },
    "stop": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase stop",
        "cwd": "{projectRoot}"
      }
    },
    "status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase status",
        "cwd": "{projectRoot}"
      }
    },
    "reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase db reset",
        "cwd": "{projectRoot}"
      }
    },
    "push": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase db push",
        "cwd": "{projectRoot}"
      }
    },
    "pull": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase db pull",
        "cwd": "{projectRoot}"
      }
    },
    "diff": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase db diff",
        "cwd": "{projectRoot}"
      }
    },
    "migration-new": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase migration new",
        "cwd": "{projectRoot}"
      }
    },
    "migration-list": {
      "executor": "nx:run-commands",
      "options": {
        "command": "supabase migration list",
        "cwd": "{projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun apps/db/scripts/verify-table-privileges.ts"
      }
    }
  }
}
