{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/api/src",
  "tags": ["scope:async"],
  "targets": {
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "source .env && export TLS_CERT=.certs/sobremesa.x-cert.pem TLS_KEY=.certs/sobremesa.x-key.pem PORT=3001 && bun run apps/api/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "command": "source .env && bun run apps/api/src/main.ts",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun build src/main.ts --outdir dist",
        "cwd": "apps/api"
      }
    }
  }
}
