{
  "name": "database",
  "tags": ["scope:infra"],
  "targets": {
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tsc --noEmit -p libs/database/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun eslint libs/database"
      }
    },
    "check-db": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/check-db.ts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun vitest run --config libs/database/vite.config.ts"
      }
    }
  }
}
