{
  "name": "agents-intern",
  "tags": ["scope:service"],
  "targets": {
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p libs/agents/intern/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint libs/agents/intern"
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "config": "libs/agents/intern/vite.config.ts"
      }
    }
  }
}
