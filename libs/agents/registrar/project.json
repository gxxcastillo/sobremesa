{
  "name": "agents-registrar",
  "tags": ["scope:service"],
  "targets": {
    "bump": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun scripts/bump-version.ts {projectRoot} {args.type}",
        "cwd": "{workspaceRoot}"
      }
    },
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tsc --noEmit -p {projectRoot}/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun eslint {projectRoot}"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun vitest run --config libs/agents/registrar/vite.config.ts"
      }
    }
  }
}
