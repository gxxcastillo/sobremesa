{
  "name": "agents-scribe",
  "tags": ["scope:service"],
  "targets": {
    "bump": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx scripts/bump-version.ts {projectRoot} {args.type}",
        "cwd": "{workspaceRoot}"
      }
    },
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p {projectRoot}/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint {projectRoot}"
      }
    }
  }
}
