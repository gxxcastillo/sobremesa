{
  "name": "pipeline",
  "tags": ["scope:service"],
  "targets": {
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tsc --noEmit -p libs/pipeline/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun eslint libs/pipeline"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun vitest run --config libs/pipeline/vite.config.ts"
      }
    }
  }
}
