{
  "name": "ai-provider",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/ai-provider/src",
  "projectType": "library",
  "tags": ["scope:service"],
  "// targets": "to see all targets run: bun nx show project ai-provider --web",
  "targets": {
    "types": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun tsc --noEmit -p libs/ai-provider/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun eslint libs/ai-provider"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun vitest run --config libs/ai-provider/vitest.config.mts"
      }
    }
  }
}
