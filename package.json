{
  "name": "@sobremesa/root",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "clean": "bun clean:modules && bun clean:dist",
    "clean:modules": "find . -name 'node_modules' -print -type d -prune -exec rm -rf '{}' + ",
    "clean:dist": "find . -name 'dist' -print -type d -prune -exec rm -rf '{}' + ",
    "prepare": "bun husky",
    "format:all": "bun prettier --write .",
    "test:all": "bun nx run-many -t test",
    "lint:all": "bun nx run-many -t lint",
    "types:all": "bun nx run-many -t types",
    "check:all": "bun nx run-many -t lint types test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@supabase/supabase-js": "^2.94.0",
    "dotenv": "^17.2.3",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "solid-js": "^1.9.11",
    "supabase": "^2.75.1",
    "telegraf": "^4.16.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nx/esbuild": "22.3.3",
    "@nx/eslint": "22.3.3",
    "@nx/eslint-plugin": "22.3.3",
    "@nx/js": "22.3.3",
    "@nx/vite": "22.3.3",
    "@nx/web": "22.3.3",
    "@swc-node/register": "~1.9.1",
    "@swc/core": "^1.5.7",
    "@swc/helpers": "~0.5.11",
    "@types/node": "20.19.9",
    "@types/semver": "^7.7.1",
    "@vitest/coverage-v8": "4.0.9",
    "@vitest/ui": "4.0.9",
    "esbuild": "^0.19.2",
    "eslint": "~8.57.0",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^16.2.7",
    "nx": "22.3.3",
    "prettier": "~3.6.2",
    "semver": "^7.7.3",
    "swc-loader": "0.1.15",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.0.5",
    "vite": "^7.0.0",
    "vite-plugin-dts": "~4.5.0",
    "vitest": "4.0.9",
    "zod-to-json-schema": "^3.25.1"
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/shared/*",
    "libs/agents/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "trustedDependencies": [
    "@swc/core",
    "esbuild",
    "nx",
    "supabase"
  ]
}
